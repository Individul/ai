---
// Chatul catalogului: caseta de intrebare e elementul principal al paginii. Raspunsurile curg
// ca text, fara chenare; citarile sunt linkuri discrete. Fara JavaScript ramane doar lamurirea.
interface Props {
  catalogId: string;
  indexate: number;   // surse cu document in Gemini
  ramase: number;
  limita: number;
}
const { catalogId, indexate, ramase, limita } = Astro.props;
const admin = Astro.locals.admin;
---

<section class="chat" id="chat" data-chat={indexate > 0 ? catalogId : undefined}>
  {indexate === 0 ? (
    <div class="gol">
      <p>Catalogul nu are încă documente indexate. Întrebările se pot pune după ce se adaugă PDF-urile actelor.</p>
      {admin && (
        <p class="pas-admin">
          <a class="buton" href={`/admin/cataloage/${catalogId}#surse`}>Adaugă sursele și PDF-urile →</a>
          <small>La fiecare sursă apeși „+ PDF”; indexarea pornește singură.</small>
        </p>
      )}
    </div>
  ) : (
    <>
      <form class="intrebare">
        <textarea name="intrebare" rows="2" maxlength="2000" placeholder="Întreabă catalogul… de exemplu: ce condiții cere liberarea condiționată?" aria-label="Întrebarea ta" required></textarea>
        <div class="rand">
          <output class="ramase" data-ramase>{ramase} din {limita} întrebări rămase azi</output>
          <button type="button" class="text" data-sterge hidden>șterge conversația</button>
          <button type="submit" class="buton principal" disabled={ramase === 0}>Întreabă</button>
        </div>
        <p class="lamurire">Răspunsurile vin doar din actele catalogului, cu trimitere la articol și la pagina din PDF. Verifică întotdeauna în act.</p>
      </form>
      <div class="schimburi" data-schimburi></div>
      <noscript><p class="lamurire">Chatul cere JavaScript.</p></noscript>
    </>
  )}
</section>

<script>
  import "../scripts/chat";
</script>

<style is:global>
  .chat { margin-top: 36px; display: flex; flex-direction: column; gap: 28px; }
  .chat .gol { display: flex; flex-direction: column; gap: 14px; color: var(--muted); font-size: 15px; }
  .chat .pas-admin { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; color: var(--text-2); font-size: 14px; }
  .chat .pas-admin small { color: var(--faint); flex-basis: 100%; }
  .chat .lamurire { color: var(--faint); font-size: 13px; line-height: 1.5; }

  /* Schimburi, cel mai nou primul, sub caseta: intrebarea ca titlu mic, raspunsul ca text */
  .chat .schimburi { display: flex; flex-direction: column; gap: 36px; padding-top: 8px; border-top: 1px solid var(--line); }
  .chat .schimb.nou { animation: apare 0.25s ease-out; }
  @keyframes apare { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: none; } }
  .chat .schimburi:empty { display: none; }
  .chat .schimb { display: flex; flex-direction: column; gap: 10px; }
  .chat .schimb .intrebare { font-family: var(--display); font-weight: 600; font-size: 19px; line-height: 1.3; color: var(--text); white-space: pre-wrap; }
  .chat .schimb .raspuns { font-size: 16px; color: var(--text-2); }
  .chat .schimb .raspuns p:last-child { margin-bottom: 0; }
  .chat .citari { display: flex; flex-wrap: wrap; gap: 4px 14px; margin-top: 2px; font-size: 13px; }
  .chat .citari::before { content: "Surse:"; color: var(--faint); font-weight: 600; }
  .chat .citare { color: var(--accent, var(--violet)); font-weight: 600; text-decoration: underline; text-decoration-color: rgba(var(--accent-rgb, 179, 147, 242), 0.35); text-underline-offset: 3px; }
  a.citare:hover { text-decoration-color: currentColor; }

  /* Caseta de intrebare */
  .chat form.intrebare { display: flex; flex-direction: column; gap: 12px; }
  .chat textarea {
    width: 100%; padding: 16px 18px; border-radius: 16px; border: 1px solid var(--line); background: var(--bg-2);
    color: var(--text); font-size: 17px; font-family: var(--body); line-height: 1.5; resize: vertical; min-height: 84px;
    transition: border-color 0.15s;
  }
  .chat textarea::placeholder { color: var(--faint); }
  .chat textarea:focus { border-color: var(--accent, var(--violet)); outline: none; }
  .chat .rand { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
  .chat .ramase { color: var(--faint); font-size: 13px; font-weight: 600; margin-right: auto; }
  .chat .ramase.eroare { color: var(--coral); }
  .chat button.text { background: none; border: 0; padding: 0; color: var(--faint); font-size: 13px; font-weight: 600; cursor: pointer; }
  .chat button.text:hover { color: var(--text); }
  /* Intrebarile anterioare: doar textul, ca linkuri; raspunsul se deschide la clic */
  .chat .anterioare { display: flex; flex-direction: column; gap: 6px; padding-top: 22px; border-top: 1px solid var(--line); }
  .chat .anterioare h3 { color: var(--faint); font-family: var(--body); font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 6px; }
  .chat details.vechi summary {
    cursor: pointer; list-style: none; color: var(--muted); font-size: 15px; font-weight: 600; line-height: 1.4; padding: 4px 0;
    text-decoration: underline; text-decoration-color: transparent; text-underline-offset: 3px; transition: color 0.15s, text-decoration-color 0.15s;
  }
  .chat details.vechi summary::-webkit-details-marker { display: none; }
  .chat details.vechi summary::before { content: "›"; display: inline-block; width: 16px; color: var(--faint); transition: transform 0.15s; }
  .chat details.vechi[open] summary::before { transform: rotate(90deg); }
  .chat details.vechi summary:hover { color: var(--text); text-decoration-color: var(--accent, var(--violet)); }
  .chat details.vechi[open] summary { color: var(--text); }
  .chat details.vechi .raspuns { padding: 8px 0 12px 16px; font-size: 15px; }
  .chat details.vechi .citari { padding: 0 0 14px 16px; }
  @media (max-width: 560px) { .chat .schimb .intrebare { font-size: 17px; } }
</style>

---
// Prima pagina: grila cataloagelor active si in lucru. Arhivatele se vad doar in /admin.
import { env } from "cloudflare:workers";
import Base from "../layouts/Base.astro";
import CardCatalog from "../components/CardCatalog.astro";
import { listeazaCataloage } from "../lib/db";

const cataloage = await listeazaCataloage(env.DB);
---

<Base title="Cataloage" lat>
  <section class="antet">
    <h1>Cataloage de legislație</h1>
    <p>
      Fiecare catalog adună actele dintr-un domeniu. Deschizi catalogul, pui întrebarea și primești
      răspunsul cu trimitere la articol și la pagina din act. Tot acolo găsești sursele în PDF,
      rezumatele audio și, pentru cine vrea, linkul spre notebook-ul NotebookLM.
    </p>
  </section>

  {cataloage.length === 0 ? (
    <p class="gol">Niciun catalog încă.</p>
  ) : (
    <section class="grila" aria-label="Cataloage">
      {cataloage.map((c) => <CardCatalog catalog={c} />)}
    </section>
  )}
</Base>

<style>
  .antet { max-width: 720px; margin-bottom: 32px; display: flex; flex-direction: column; gap: 12px; }
  .antet p { color: var(--text-2); font-size: 17px; }
  .grila { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 22px; }
  .gol { color: var(--muted); padding: 40px 0; text-align: center; }
  @media (max-width: 560px) { .grila { grid-template-columns: 1fr; gap: 16px; } h1 { font-size: 28px; } }
</style>

{
  "name": "ai",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "astro": "astro",
    "test": "vitest run",
    "migrate:local": "wrangler d1 migrations apply ai --local",
    "migrate:remote": "wrangler d1 migrations apply ai --remote",
    "deploy": "astro build && wrangler deploy",
    "generate-types": "wrangler types",
    "dev:worker": "astro build && wrangler dev --local-upstream localhost",
    "dev:retea": "astro build && wrangler dev --local-upstream localhost --ip 0.0.0.0"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.0",
    "astro": "^7.3.1",
    "pdf-lib": "^1.17.1",
    "wrangler": "^4.129.1"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260906.1",
    "@types/node": "^26.5.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.0"
  }
}

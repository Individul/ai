---
// Admin: toate cataloagele (si arhivatele), ordonare, intrare la editare.
import { env } from "cloudflare:workers";
import Base from "../../layouts/Base.astro";
import Pictograma from "../../components/Pictograma.astro";
import { listeazaCataloage } from "../../lib/db";
import { ETICHETE_STARE } from "../../lib/validare";
import { fmtMoment } from "../../lib/data";

const cataloage = await listeazaCataloage(env.DB, { cuArhivate: true });
---

<Base title="Admin · Cataloage">
  <header class="antet">
    <h1>Administrare</h1>
    <a class="buton principal" href="/admin/cataloage/nou">+ Catalog nou</a>
  </header>

  {cataloage.length === 0 ? (
    <p class="gol">Niciun catalog. Creează primul.</p>
  ) : (
    <ul class="lista">
      {cataloage.map((c, i) => (
        <li class:list={[`culoare-${c.culoare}`, { arhivat: c.stare === "arhivat" }]}>
          <div class="icon"><Pictograma nume={c.pictograma} marime={22} /></div>
          <div class="text">
            <a class="titlu" href={`/admin/cataloage/${c.id}`}>{c.titlu}</a>
            <span class="meta">
              /c/{c.slug} · {c.nr_surse} surse · {c.nr_audio} audio · {fmtMoment(c.actualizat_la)}
            </span>
          </div>
          <span class:list={["insigna", c.stare]}>{ETICHETE_STARE[c.stare]}</span>
          <form method="post" class="ordine">
            <button class="buton mic" formaction={`/admin/actiuni/catalog/${c.id}/muta?dir=sus`} disabled={i === 0} title="Mai sus" aria-label="Mai sus">↑</button>
            <button class="buton mic" formaction={`/admin/actiuni/catalog/${c.id}/muta?dir=jos`} disabled={i === cataloage.length - 1} title="Mai jos" aria-label="Mai jos">↓</button>
          </form>
          <a class="buton mic" href={`/admin/cataloage/${c.id}`}>Editează</a>
        </li>
      ))}
    </ul>
  )}
</Base>

<style>
  .antet { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 24px; flex-wrap: wrap; }
  .gol { color: var(--muted); }
  .lista { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  li {
    display: flex; align-items: center; gap: 14px; padding: 12px 16px;
    border-radius: 16px; background: var(--bg-2); border: 1px solid var(--line);
  }
  li.arhivat { opacity: 0.6; }
  .icon { flex: none; width: 38px; height: 38px; border-radius: 12px; display: grid; place-items: center; background: var(--accent); color: #16121D; }
  .text { display: flex; flex-direction: column; min-width: 0; flex: 1; }
  .titlu { font-weight: 700; }
  .titlu:hover { color: var(--violet); }
  .meta { color: var(--muted); font-size: 13px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ordine { display: flex; gap: 4px; }
  @media (max-width: 640px) {
    li { flex-wrap: wrap; }
    .text { flex-basis: calc(100% - 52px); }
  }
</style>

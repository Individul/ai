# Copiaza in .dev.vars (niciodata comis). Identitatea folosita local, in lipsa Cloudflare Access.
DEV_EMAIL=dev@local
# Cine poate intra la /admin (lista separata prin virgula). In productie se pune in wrangler.jsonc, vars.ADMIN_EMAILS.
ADMIN_EMAILS=dev@local
# Cheia DeepSeek (platform.deepseek.com, sold preplatit): modelul de rezerva al chatului si corectorul. Fara ea, 503.
DEEPSEEK_API_KEY=
# Cheia Anthropic (platform.claude.com → API keys, legata de un workspace). Fara ea, chatul (Sonnet 5.5) si corectorul pe modelele Claude raspund 503. Se plateste din creditele API lunare ale abonamentului Max.
ANTHROPIC_API_KEY=

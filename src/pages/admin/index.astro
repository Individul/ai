---
// Admin: toate cataloagele (si arhivatele), ordonare, intrare la editare. Randuri simple.
import { env } from "cloudflare:workers";
import Base from "../../layouts/Base.astro";
import Pictograma from "../../components/Pictograma.astro";
import { listeazaCataloage } from "../../lib/db";
import { ETICHETE_STARE } from "../../lib/validare";
import { fmtMoment } from "../../lib/data";

const cataloage = await listeazaCataloage(env.DB, { cuArhivate: true });
---

<Base title="Admin · Cataloage">
  <header class="antet">
    <h1>Administrare</h1>
    <nav class="actiuni">
      <a href="/admin/consum">Consum și limite</a>
      <a class="buton principal" href="/admin/cataloage/nou">+ Catalog nou</a>
    </nav>
  </header>

  {cataloage.length === 0 ? (
    <p class="gol">Niciun catalog. Creează primul.</p>
  ) : (
    <ul class="lista">
      {cataloage.map((c, i) => (
        <li class:list={[`culoare-${c.culoare}`, { arhivat: c.stare === "arhivat" }]}>
          <div class="icon"><Pictograma nume={c.pictograma} marime={16} /></div>
          <div class="text">
            <a class="titlu" href={`/admin/cataloage/${c.id}`}>{c.titlu}</a>
            <span class="meta">{c.nr_surse} surse · {c.nr_audio} audio · {fmtMoment(c.actualizat_la)}</span>
          </div>
          <span class:list={["insigna", c.stare]}>{ETICHETE_STARE[c.stare]}</span>
          <form method="post" class="ordine">
            <button formaction={`/admin/actiuni/catalog/${c.id}/muta?dir=sus`} disabled={i === 0} title="Mai sus" aria-label="Mai sus">↑</button>
            <button formaction={`/admin/actiuni/catalog/${c.id}/muta?dir=jos`} disabled={i === cataloage.length - 1} title="Mai jos" aria-label="Mai jos">↓</button>
          </form>
          <a class="editeaza" href={`/admin/cataloage/${c.id}`}>editează</a>
        </li>
      ))}
    </ul>
  )}
</Base>

<style>
  .antet { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 28px; flex-wrap: wrap; }
  .actiuni { display: flex; align-items: center; gap: 18px; font-size: 14px; font-weight: 600; color: var(--muted); }
  .actiuni a:not(.buton):hover { color: var(--text); }
  .gol { color: var(--muted); }
  .lista { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  li { display: flex; align-items: center; gap: 14px; padding: 14px 0; border-top: 1px solid var(--line); }
  li:last-child { border-bottom: 1px solid var(--line); }
  li.arhivat .text { opacity: 0.55; }
  .icon { flex: none; width: 30px; height: 30px; border-radius: 9px; display: grid; place-items: center; background: rgba(var(--accent-rgb), 0.16); color: var(--accent); }
  .text { display: flex; flex-direction: column; min-width: 0; flex: 1; }
  .titlu { font-weight: 600; }
  .titlu:hover { color: var(--accent); }
  .meta { color: var(--faint); font-size: 13px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ordine { display: flex; gap: 2px; }
  .ordine button { background: none; border: 0; color: var(--faint); font-size: 14px; width: 26px; height: 26px; border-radius: 8px; cursor: pointer; }
  .ordine button:hover:not(:disabled) { color: var(--text); background: var(--line); }
  .ordine button:disabled { opacity: 0.3; cursor: default; }
  .editeaza { font-size: 13px; font-weight: 600; color: var(--muted); }
  .editeaza:hover { color: var(--text); }
  @media (max-width: 640px) {
    li { flex-wrap: wrap; }
    .text { flex-basis: calc(100% - 44px); }
  }
</style>

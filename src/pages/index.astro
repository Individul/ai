---
// Prima pagina: grila cataloagelor active si in lucru. Arhivatele se vad doar in /admin.
import { env } from "cloudflare:workers";
import Base from "../layouts/Base.astro";
import CardCatalog from "../components/CardCatalog.astro";
import { listeazaCataloage } from "../lib/db";

const cataloage = await listeazaCataloage(env.DB);
---

<Base title="Culegeri" lat>
  <section class="antet">
    <h1>Culegeri de legislație</h1>
    <p>Alege o culegere, pune întrebarea și primești răspunsul cu trimitere la articol și la pagina din act.</p>
  </section>

  {cataloage.length === 0 ? (
    <p class="gol">Nicio culegere încă.</p>
  ) : (
    <section class="grila" aria-label="Culegeri">
      {cataloage.map((c) => <CardCatalog catalog={c} />)}
    </section>
  )}
</Base>

<style>
  .antet { max-width: 640px; margin-bottom: 28px; display: flex; flex-direction: column; gap: 8px; }
  .antet p { color: var(--muted); font-size: 16px; }
  .grila { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px; }
  .gol { color: var(--muted); padding: 40px 0; text-align: center; }
  @media (max-width: 560px) { .grila { grid-template-columns: 1fr; gap: 12px; } h1 { font-size: 28px; } }
</style>

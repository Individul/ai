---
// Sursele unui catalog: lista simpla, grupata pe tip. Titlul deschide PDF-ul (daca exista);
// descarcarea si linkul extern sunt actiuni discrete la capatul randului.
import type { Sursa } from "../lib/db";
import { ETICHETE_TIP, TIPURI_SURSA, fmtMarime } from "../lib/validare";
import { fmtZi } from "../lib/data";

interface Props {
  surse: Sursa[];
}
const { surse } = Astro.props;
const grupuri = TIPURI_SURSA
  .map((tip) => ({ tip, eticheta: ETICHETE_TIP[tip], surse: surse.filter((s) => s.tip === tip) }))
  .filter((g) => g.surse.length > 0);
---

{surse.length === 0 ? (
  <p class="gol">Nicio sursă adăugată încă.</p>
) : (
  <div class="grupuri">
    {grupuri.map((g) => (
      <section class="grup">
        <h3>{g.eticheta}</h3>
        <ul>
          {g.surse.map((s) => (
            <li>
              <div class="text">
                {s.fisier_nume ? (
                  <a class="titlu" href={`/f/pdf/${s.id}`} target="_blank" rel="noopener">{s.titlu}</a>
                ) : (
                  <span class="titlu">{s.titlu}</span>
                )}
                <span class="meta">
                  {s.numar && <span>nr. {s.numar}</span>}
                  {s.data_emiterii && <span>{fmtZi(s.data_emiterii)}</span>}
                  {s.fisier_nume && <span>PDF, {fmtMarime(s.fisier_marime ?? 0)}</span>}
                  {s.fisier_nume && s.indexare === "gata" && <span class="in-chat">în chat</span>}
                </span>
              </div>
              <div class="actiuni">
                {s.url && <a href={s.url} target="_blank" rel="noopener noreferrer" title="Pagina actului">link ↗</a>}
                {s.fisier_nume && <a href={`/f/pdf/${s.id}?descarca=1`} title={`Descarcă ${s.fisier_nume}`}>descarcă ↓</a>}
              </div>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
)}

<style>
  .gol { color: var(--muted); }
  .grupuri { display: flex; flex-direction: column; gap: 26px; }
  .grup h3 { color: var(--faint); font-family: var(--body); font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 10px; }
  ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 14px; }
  li { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; }
  .text { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .titlu { font-weight: 600; font-size: 16px; }
  a.titlu { text-decoration: underline; text-decoration-color: transparent; text-underline-offset: 3px; transition: text-decoration-color 0.15s; }
  a.titlu:hover { text-decoration-color: var(--accent, var(--violet)); color: var(--accent, var(--violet)); }
  .meta { display: flex; flex-wrap: wrap; gap: 4px 12px; color: var(--faint); font-size: 13px; }
  .in-chat { color: var(--live); font-weight: 600; }
  .actiuni { display: flex; gap: 14px; flex: none; font-size: 13px; font-weight: 600; color: var(--muted); white-space: nowrap; }
  .actiuni a:hover { color: var(--text); }
  @media (max-width: 560px) {
    li { flex-direction: column; align-items: flex-start; gap: 6px; }
  }
</style>

---
// Rezumatele audio ale unui catalog: rand simplu, player dedesubt. preload="none": fisierele
// sunt mari si protejate; browserul le cere doar la play (cu Range, deci serverul raspunde 206).
import type { Audio } from "../lib/db";
import { fmtDurata, fmtMarime } from "../lib/validare";
import { fmtZi } from "../lib/data";

interface Props {
  audio: Audio[];
}
const { audio } = Astro.props;
---

{audio.length === 0 ? (
  <p class="gol">Niciun rezumat audio încă.</p>
) : (
  <ul>
    {audio.map((a) => (
      <li>
        <div class="cap">
          <div class="text">
            <span class="titlu">{a.titlu}</span>
            <span class="meta">
              <span>{fmtZi(a.data)}</span>
              {a.durata_s !== null && <span>{fmtDurata(a.durata_s)}</span>}
              <span>{fmtMarime(a.marime)}</span>
            </span>
          </div>
          <a class="actiune" href={`/f/audio/${a.id}?descarca=1`} title={`Descarcă ${a.fisier_nume}`}>descarcă ↓</a>
        </div>
        {a.descriere && <p class="descriere">{a.descriere}</p>}
        <audio controls preload="none" src={`/f/audio/${a.id}`}></audio>
      </li>
    ))}
  </ul>
)}

<style>
  .gol { color: var(--muted); }
  ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 22px; }
  li { display: flex; flex-direction: column; gap: 8px; }
  .cap { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
  .text { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .titlu { font-weight: 600; font-size: 16px; }
  .meta { display: flex; gap: 12px; color: var(--faint); font-size: 13px; }
  .actiune { flex: none; font-size: 13px; font-weight: 600; color: var(--muted); white-space: nowrap; }
  .actiune:hover { color: var(--text); }
  .descriere { color: var(--text-2); font-size: 14px; }
  audio { width: 100%; height: 40px; }
</style>

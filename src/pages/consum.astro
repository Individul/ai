---
// Consumul propriu: cate intrebari azi, limita, ultimele intrebari cu raspunsuri.
import { env } from "cloudflare:workers";
import Base from "../layouts/Base.astro";
import Suma from "../components/Suma.astro";
import { consumUtilizator, intrebariAzi, istoricUtilizator, limitaPentru } from "../lib/consum";
import { aziChisinau, fmtMoment } from "../lib/data";
import { cursUsd } from "../lib/curs";
import { listeazaCataloage } from "../lib/db";
import { randeazaMarkdown } from "../lib/markdown";

const email = Astro.locals.email;
const zi = aziChisinau();
const [folosite, limita, istoric, cataloage, consum, curs] = await Promise.all([
  intrebariAzi(env.DB, email, zi), limitaPentru(env.DB, email), istoricUtilizator(env.DB, email, 50),
  listeazaCataloage(env.DB, { cuArhivate: true }), consumUtilizator(env.DB, email, zi), cursUsd(env.DB, zi),
]);
const numeCatalog = new Map(cataloage.map((c) => [c.id, c.titlu]));
const ramase = Math.max(0, limita - folosite);
---

<Base title="Consumul meu · Culegeri">
  <h1>Consumul meu</h1>
  <p class="rezumat">
    Azi ai pus <strong>{folosite}</strong> {folosite === 1 ? "întrebare" : "întrebări"} din <strong>{limita}</strong>.
    Mai ai <strong>{ramase}</strong>. Limita se resetează la miezul nopții.
  </p>
  <dl class="cifre">
    <div><dt>Cost azi</dt><dd><Suma microdolari={consum.cost_azi} curs={curs} /></dd></div>
    <div><dt>Ultimele 30 de zile</dt><dd><Suma microdolari={consum.cost_30} curs={curs} /> <small>· {consum.zile30} {consum.zile30 === 1 ? "întrebare" : "întrebări"}</small></dd></div>
    <div><dt>De la început</dt><dd><Suma microdolari={consum.cost_total} curs={curs} /> <small>· {consum.total} {consum.total === 1 ? "întrebare" : "întrebări"}</small></dd></div>
  </dl>
  <p class="lamurire">Costul e estimat din tokenii raportați de Google și tariful modelului folosit la fiecare întrebare.</p>

  <h2>Ultimele întrebări</h2>
  {istoric.length === 0 ? (
    <p class="gol">Nicio întrebare încă. Deschide o culegere și întreabă.</p>
  ) : (
    <ul class="lista">
      {istoric.map((i) => (
        <li class:list={[i.stare]}>
          <div class="meta">
            <span>{fmtMoment(i.creat_la)}</span>
            <span>·</span>
            <span>{numeCatalog.get(i.catalog_id) ?? "culegere"}</span>
            {i.stare === "refuzat" && <span class="eticheta">refuzată, limita atinsă</span>}
            {i.stare === "eroare" && <span class="eticheta">eroare</span>}
            {i.stare === "ok" && <span class="cost"><Suma microdolari={i.cost_microdolari} curs={curs} titlu={`${i.tokens_intrare} tokeni intrare · ${i.tokens_iesire} ieșire · ${i.model}`} /></span>}
          </div>
          <p class="intrebare">{i.intrebare}</p>
          {i.stare === "ok" && <div class="proza raspuns" set:html={randeazaMarkdown(i.raspuns)} />}
        </li>
      ))}
    </ul>
  )}
</Base>

<style>
  h1 { margin-bottom: 12px; }
  h2 { margin: 32px 0 14px; }
  .rezumat { color: var(--text-2); font-size: 17px; }
  .rezumat strong { color: var(--text); }
  .cifre { display: flex; flex-wrap: wrap; gap: 12px; margin: 18px 0 8px; }
  .cifre div { flex: 1 1 160px; padding: 12px 16px; border-radius: 14px; background: var(--bg-2); border: 1px solid var(--line); }
  .cifre dt { color: var(--muted); font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; }
  .cifre dd { margin: 4px 0 0; font-family: var(--display); font-size: 22px; font-weight: 600; }
  .cifre dd small { font-family: var(--body); font-size: 13px; font-weight: 500; color: var(--faint); }
  .lamurire { color: var(--faint); font-size: 13px; }
  .cost { margin-left: auto; color: var(--muted); }
  .gol { color: var(--muted); }
  .lista { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px; }
  li { display: flex; flex-direction: column; gap: 8px; padding: 14px 16px; border-radius: 16px; background: var(--bg-2); border: 1px solid var(--line); }
  li.refuzat, li.eroare { opacity: 0.7; }
  .meta { display: flex; gap: 8px; flex-wrap: wrap; color: var(--faint); font-size: 12.5px; font-weight: 600; }
  .eticheta { color: var(--coral); }
  .intrebare { font-weight: 700; }
  .raspuns { font-size: 15px; }
</style>

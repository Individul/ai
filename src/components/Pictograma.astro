---
// Setul fix de pictograme ale cataloagelor (aceeasi linie ca in portofoliu: stroke 2.2).
import type { Pictograma } from "../lib/validare";

interface Props {
  nume: Pictograma | string;
  marime?: number;
}
const { nume, marime = 30 } = Astro.props;
---

<svg width={marime} height={marime} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {nume === "balanta" && <><path d="M12 3v18"/><path d="M4 7h16"/><path d="M8 21h8"/><path d="M4 7l-2.5 7a3 3 0 0 0 5 0z"/><path d="M20 7l-2.5 7a3 3 0 0 0 5 0z"/></>}
  {nume === "ciocan" && <><path d="M14 4l6 6"/><path d="M12 6l6 6"/><path d="M16 8l-2 2-4-4 2-2z" fill="currentColor" stroke="none"/><path d="M11 9l-7.5 7.5a1.5 1.5 0 0 0 2 2L13 11"/><path d="M4 21h9"/></>}
  {nume === "document" && <><path d="M7 3h7l5 5v13H7z"/><path d="M14 3v5h5"/><path d="M10 13h6M10 17h6"/></>}
  {nume === "lacat" && <><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/><circle cx="12" cy="16" r="1" fill="currentColor"/></>}
  {nume === "cheie" && <><circle cx="8" cy="14" r="4"/><path d="M11 11l9-9"/><path d="M17 5l2.5 2.5"/><path d="M14 8l2.5 2.5"/></>}
  {(nume === "carte" || !["balanta", "ciocan", "document", "lacat", "cheie"].includes(String(nume))) && <><path d="M12 6c-1.5-1.5-4-2-8-2v14c4 0 6.5.5 8 2 1.5-1.5 4-2 8-2V4c-4 0-6.5.5-8 2z"/><path d="M12 6v14"/></>}
</svg>

---
// Corectorul de documente Word: colegul incarca un .docx, textul merge la modelul din
// setari.model_corector, iar documentul se intoarce cu corecturile ca revizii Word. Doua moduri, ca in
// aplicatia de Mac: corectura (corpul, pe loturi) si verificare (tot documentul intr-o cerere, cu antete
// si observatii). Tot lucrul cu fisierul e in browser (src/scripts/corector.ts); serverul vede doar textul.
import { env } from "cloudflare:workers";
import Base from "../layouts/Base.astro";
import Suma from "../components/Suma.astro";
import { corectariUtilizator, modelCorector } from "../lib/consum";
import { cheieMotor } from "../lib/motor";
import { cursUsd } from "../lib/curs";
import { aziChisinau, fmtMoment } from "../lib/data";
import { LIMITA_VERIFICARE, numara } from "../lib/corector";
import { motorModel, NUME_MOTOR, stareVarf, TARIFE } from "../lib/validare";
import { textVarf } from "../lib/varf";

const [model, documente, curs] = await Promise.all([
  modelCorector(env.DB), corectariUtilizator(env.DB, Astro.locals.email, 20), cursUsd(env.DB, aziChisinau()),
]);
const motor = motorModel(model) ?? "gemini";
const configurat = !!cheieMotor(env, motor);
const numeModel = TARIFE[model]?.eticheta.split(" · ")[0] ?? model;
const varf = textVarf(stareVarf(model));
const descriere = (d: (typeof documente)[number]) => {
  if (d.stare !== "ok") return d.stare === "eroare" ? "eroare" : "neterminat";
  const parti = [numara(d.aplicate, "corectură", "corecturi")];
  // Si la „corectură” pot fi observatii: cele gasite in cod, pe datele personale.
  if (d.observatii) parti.push(numara(d.observatii, "observație", "observații"));
  return parti.join(" · ");
};
---

<Base title="Corector · Culegeri">
  <h1>Corector</h1>
  <p class="intro">
    Încarcă un document Word. Corectorul verifică ortografia, gramatica și punctuația și reformulează frazele greoaie,
    iar tu primești înapoi același document, cu fiecare corectură ca modificare urmărită: o accepți sau o respingi în Word.
  </p>

  {configurat ? (
    <section class="corector" data-corector>
      <fieldset class="moduri">
        <legend>Ce fac cu documentul</legend>
        <label>
          <input type="radio" name="mod" value="corectura" data-mod checked />
          <span class="nume">Corectură</span>
          <span class="sub">Corpul documentului, pe bucăți. Merge și pe documente mari.</span>
        </label>
        <label>
          <input type="radio" name="mod" value="verificare" data-mod />
          <span class="nume">Verificare</span>
          <span class="sub">Tot documentul odată, cu antet și subsol, plus observațiile care cer om. Până la {(LIMITA_VERIFICARE / 1000)} mii de caractere.</span>
        </label>
      </fieldset>
      <fieldset class="moduri trei">
        <legend>Datele personale</legend>
        <label>
          <input type="radio" name="mascare" value="tot" data-mascare checked />
          <span class="nume">Nume și identificatori</span>
          <span class="sub">Numele, IDNP-ul, telefonul, adresa și data nașterii pleacă înlocuite cu date false. Se pun la loc aici, în browser.</span>
        </label>
        <label>
          <input type="radio" name="mascare" value="identificatori" data-mascare />
          <span class="nume">Doar identificatorii</span>
          <span class="sub">Numele rămân, ca modelul să le poată verifica scrierea.</span>
        </label>
        <label>
          <input type="radio" name="mascare" value="fara" data-mascare />
          <span class="nume">Fără mascare</span>
          <span class="sub">Documentul pleacă așa cum e.</span>
        </label>
      </fieldset>
      <label class="zona" data-zona>
        <input type="file" accept=".docx,application/vnd.openxmlformats-officedocument.wordprocessingml.document" data-fisier />
        <span class="zona-titlu">Alege un document .docx</span>
        <span class="zona-sub">sau trage-l aici</span>
      </label>
      <p class="stare" data-stare aria-live="polite"></p>
      <div class="progres" data-progres hidden><span></span></div>

      <div class="rezultat" data-rezultat hidden>
        <div class="rezumat">
          <p data-rezumat></p>
          <a class="buton principal" data-descarca href="#" download>Descarcă documentul corectat</a>
        </div>
        <details class="ascunse" data-ascunse hidden>
          <summary></summary>
          <ul></ul>
        </details>
        <ul class="observatii" data-observatii hidden></ul>
        <ol class="corecturi" data-lista></ol>
      </div>

      <p class="lamurire">
        Textul documentului e trimis modelului {numeModel} ({NUME_MOTOR[motor]}), cu numele și identificatorii înlocuiți
        mai întâi cu date false — nu e anonimizare, restul actului pleacă așa cum e; pe server rămân doar numele fișierului,
        mascat și el, numărul de corecturi și costul. La „corectură” se lucrează pe corpul documentului, la „verificare” intră
        și antetele, subsolurile și notele, iar observațiile care cer om vin fiecare cu soluția ei: o accepți cu un clic sau o
        bifezi ca rezolvată. La fiecare document se verifică și mențiunea obligatorie despre datele cu caracter personal.
      </p>
      {varf && <p class:list={["lamurire", "varf", { activ: varf.activ }]}>{varf.text.replace("fiecare întrebare", "fiecare document")}</p>}
    </section>
  ) : (
    <p class="gol">Corectorul nu este configurat încă pe server.</p>
  )}

  <h2>Documentele tale</h2>
  {documente.length === 0 ? (
    <p class="gol">Niciun document corectat încă.</p>
  ) : (
    <ul class="documente">
      {documente.map((d) => (
        <li class:list={[d.stare]}>
          <span class="nume">{d.fisier}</span>
          <span class="detalii" title={d.mesaj ?? undefined}>{fmtMoment(d.creat_la)} · {descriere(d)}</span>
          <span class="cost"><Suma microdolari={d.cost_microdolari} curs={curs} titlu={`${d.tokens_intrare} tokeni intrare · ${d.tokens_iesire} ieșire · ${d.model}`} /></span>
        </li>
      ))}
    </ul>
  )}
</Base>

<script>
  import "../scripts/corector";
</script>

<style>
  .intro { color: var(--text-2); font-size: 17px; margin: 10px 0 24px; max-width: 640px; }
  .moduri { display: flex; flex-wrap: wrap; gap: 10px; border: 0; padding: 0; margin: 0 0 16px; }
  .moduri legend { font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--faint); padding: 0 0 8px; }
  .moduri label {
    flex: 1 1 260px; display: flex; flex-direction: column; gap: 2px; padding: 10px 14px; border-radius: 14px;
    border: 1px solid var(--line); cursor: pointer; transition: background 0.15s, border-color 0.15s;
  }
  .moduri.trei label { flex-basis: 190px; }
  .moduri label:hover { border-color: rgba(var(--violet-rgb), 0.5); }
  .moduri label:has(input:checked) { border-color: var(--violet); background: rgba(var(--violet-rgb), 0.07); }
  .moduri label:focus-within { outline: 2px solid var(--coral); outline-offset: 2px; }
  .moduri input { position: absolute; width: 1px; height: 1px; opacity: 0; }
  .moduri .nume { font-weight: 700; font-size: 15px; }
  .moduri label:has(input:checked) .nume { color: var(--violet); }
  .moduri .sub { color: var(--faint); font-size: 12.5px; }
  .ascunse { border-bottom: 1px solid var(--line); padding: 10px 0; }
  .ascunse summary { cursor: pointer; font-size: 13.5px; color: var(--faint); }
  .ascunse summary:hover { color: var(--text-2); }
  .ascunse ul { list-style: none; margin: 8px 0 2px; padding: 0; display: grid; gap: 4px; }
  .ascunse :global(li) { display: flex; flex-wrap: wrap; gap: 8px; font-size: 13.5px; color: var(--text-2); }
  .ascunse :global(.adevarat) { min-width: 200px; }
  .ascunse :global(.adevarat)::after { content: " →"; color: var(--faint); }
  .ascunse :global(.fals) { color: var(--faint); }

  .observatii { list-style: none; margin: 0; padding: 0; }
  .observatii :global(li) { display: flex; flex-direction: column; gap: 3px; padding: 12px 0 12px 14px; border-bottom: 1px solid var(--line); border-left: 2px solid rgba(var(--galben-rgb), 0.55); }
  .observatii :global(.tip) { font-size: 11.5px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--wip); }
  .observatii :global(.text) { font-size: 14.5px; color: var(--text-2); overflow-wrap: anywhere; }
  .observatii :global(.solutie) { font-size: 14px; color: var(--text-2); overflow-wrap: anywhere; }
  .observatii :global(.solutie b) { color: var(--verde); }
  .observatii :global(.alegere) { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 5px; }
  .observatii :global(.alegere button) {
    font: inherit; font-size: 12.5px; font-weight: 600; padding: 4px 12px; border-radius: 999px;
    border: 1px solid var(--line); background: transparent; color: var(--muted); cursor: pointer;
  }
  .observatii :global(.alegere button:hover) { border-color: rgba(var(--violet-rgb), 0.6); color: var(--text); }
  .observatii :global(.alegere button.ales) { background: var(--violet); border-color: var(--violet); color: var(--pe-accent); }
  .observatii :global(.manual) { font-size: 12.5px; color: var(--faint); }
  .observatii :global(li.bifata) { opacity: 0.55; }
  .observatii :global(li.bifata .tip)::after { content: " · rezolvată"; color: var(--verde); }
  .observatii :global(.problema) { font-size: 12.5px; color: var(--coral); }
  .zona {
    position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px;
    padding: 34px 20px; border-radius: 18px; border: 1.5px dashed rgba(var(--violet-rgb), 0.45);
    background: rgba(var(--violet-rgb), 0.05); cursor: pointer; text-align: center; transition: background 0.15s, border-color 0.15s;
  }
  .zona:hover, .zona:global(.peste) { background: rgba(var(--violet-rgb), 0.11); border-color: var(--violet); }
  .zona:focus-within { outline: 2px solid var(--coral); outline-offset: 2px; }
  .zona:global(.ocupat) { pointer-events: none; opacity: 0.55; }
  .zona input { position: absolute; width: 1px; height: 1px; opacity: 0; }
  .zona-titlu { font-weight: 700; color: var(--violet); font-size: 16px; }
  .zona-sub { color: var(--faint); font-size: 13px; }
  .stare { min-height: 22px; margin: 12px 0 6px; color: var(--muted); font-size: 14px; font-weight: 600; }
  .stare:global(.eroare) { color: var(--coral); }
  .progres { height: 4px; border-radius: 4px; background: var(--line); overflow: hidden; margin-bottom: 8px; }
  .progres span { display: block; height: 100%; width: 0; background: var(--violet); transition: width 0.3s; }
  .rezumat { display: flex; align-items: center; justify-content: space-between; gap: 12px 20px; flex-wrap: wrap; padding: 6px 0 14px; border-bottom: 1px solid var(--line); }
  .rezumat p { color: var(--text-2); font-size: 15px; flex: 1 1 280px; }
  .corecturi { list-style: none; margin: 0; padding: 0; }
  .corecturi :global(li) { display: flex; flex-direction: column; gap: 3px; padding: 12px 0; border-bottom: 1px solid var(--line); }
  .corecturi :global(.tip) { display: flex; flex-wrap: wrap; gap: 4px 10px; font-size: 11.5px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--faint); }
  .corecturi :global(.neaplicata) { color: var(--wip); text-transform: none; letter-spacing: 0; font-size: 12.5px; }
  .corecturi :global(.fragment) { font-size: 15px; color: var(--text-2); overflow-wrap: anywhere; }
  .corecturi :global(del) { color: var(--coral); background: rgba(var(--coral-rgb), 0.1); border-radius: 4px; padding: 0 2px; }
  .corecturi :global(ins) { color: var(--verde); background: rgba(var(--verde-rgb), 0.12); text-decoration: none; border-radius: 4px; padding: 0 2px; }
  .corecturi :global(.motiv) { font-size: 13.5px; color: var(--muted); }
  .lamurire { color: var(--faint); font-size: 13px; margin-top: 18px; }
  .varf { margin-top: 6px; }
  .varf.activ { color: var(--coral); font-weight: 600; }
  h2 { margin: 40px 0 10px; }
  .gol { color: var(--muted); }
  .documente { list-style: none; margin: 0; padding: 0; }
  .documente li { display: flex; align-items: baseline; flex-wrap: wrap; gap: 2px 14px; padding: 10px 0; border-bottom: 1px solid var(--line); font-size: 14px; }
  .documente .nume { font-weight: 600; overflow-wrap: anywhere; }
  .documente .detalii { color: var(--faint); font-size: 13px; }
  .documente .cost { margin-left: auto; color: var(--muted); font-size: 13px; }
  .documente li.eroare .detalii, .documente li.in_curs .detalii { color: var(--coral); }
</style>

---
// Pagina unui catalog: chat, surse grupate pe tip, audio, note de utilizare.
import { env } from "cloudflare:workers";
import Base from "../../layouts/Base.astro";
import Pictograma from "../../components/Pictograma.astro";
import ListaSurse from "../../components/ListaSurse.astro";
import ListaAudio from "../../components/ListaAudio.astro";
import Chat from "../../components/Chat.astro";
import { citesteCatalogDupaSlug, listeazaAudio, listeazaSurse } from "../../lib/db";
import { intrebariAzi, limitaPentru } from "../../lib/consum";
import { aziChisinau } from "../../lib/data";
import { ETICHETE_STARE } from "../../lib/validare";
import { randeazaMarkdown } from "../../lib/markdown";
import { fmtMoment } from "../../lib/data";

const slug = Astro.params.slug ?? "";
const catalog = await citesteCatalogDupaSlug(env.DB, slug);
if (!catalog || (catalog.stare === "arhivat" && !Astro.locals.admin)) {
  return new Response(null, { status: 404 });
}
const email = Astro.locals.email;
const [surse, audio, folosite, limita] = await Promise.all([
  listeazaSurse(env.DB, catalog.id), listeazaAudio(env.DB, catalog.id),
  intrebariAzi(env.DB, email, aziChisinau()), limitaPentru(env.DB, email),
]);
const indexate = catalog.magazin ? surse.filter((s) => s.indexare === "gata").length : 0;
const note = catalog.note_utilizare ? randeazaMarkdown(catalog.note_utilizare) : "";
---

<Base title={`${catalog.titlu} · Cataloage`}>
  <article class:list={["catalog", `culoare-${catalog.culoare}`]}>
    <header class="antet">
      <div class="rand">
        <div class="icon"><Pictograma nume={catalog.pictograma} marime={22} /></div>
        <span class:list={["insigna", catalog.stare]}>{ETICHETE_STARE[catalog.stare]}</span>
      </div>
      <h1>{catalog.titlu}</h1>
      {catalog.descriere && <p class="descriere">{catalog.descriere}</p>}
    </header>

    <Chat catalogId={catalog.id} indexate={indexate} ramase={Math.max(0, limita - folosite)} limita={limita} />

    <section class="sectiune">
      <h2>Surse <span class="numar">{surse.length}</span></h2>
      <ListaSurse surse={surse} />
    </section>

    {audio.length > 0 && (
      <section class="sectiune">
        <h2>Rezumate audio <span class="numar">{audio.length}</span></h2>
        <ListaAudio audio={audio} />
      </section>
    )}

    {note && (
      <section class="sectiune">
        <h2>Note de utilizare</h2>
        <div class="proza" set:html={note} />
      </section>
    )}

    <footer class="ultima">ultima actualizare {fmtMoment(catalog.actualizat_la)}</footer>
  </article>
</Base>

<style>
  .antet { display: flex; flex-direction: column; gap: 12px; }
  .antet .rand { display: flex; align-items: center; gap: 12px; }
  .icon {
    width: 40px; height: 40px; border-radius: 12px; display: grid; place-items: center;
    background: var(--accent); color: #16121D;
  }
  h1 { font-size: 40px; letter-spacing: -0.02em; }
  .descriere { color: var(--muted); font-size: 17px; max-width: 60ch; }
  .sectiune { margin-top: 56px; display: flex; flex-direction: column; gap: 18px; }
  .sectiune h2 { display: flex; align-items: baseline; gap: 10px; font-size: 20px; }
  .numar { color: var(--faint); font-size: 14px; font-weight: 600; }
  .ultima { margin-top: 56px; color: var(--faint); font-size: 13px; font-weight: 600; }
  @media (max-width: 560px) {
    h1 { font-size: 30px; }
    .descriere { font-size: 16px; }
    .sectiune { margin-top: 44px; }
  }
</style>

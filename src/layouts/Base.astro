---
// Scheletul fiecarei pagini: bara de sus, continut, subsol.
// Paleta si fonturile sunt cele din portofoliu (dumitru.cloud).
// Manifestul are crossorigin="use-credentials": Access cere cookie-ul de sesiune si la
// manifest, iar fetch-ul implicit al browserului nu il trimite.
import Bara from "../components/Bara.astro";

interface Props {
  title: string;
  // Continut lat (grila de carduri) sau ingust (text).
  lat?: boolean;
}
const { title, lat = false } = Astro.props;
const email = Astro.locals.email;
---

<!doctype html>
<html lang="ro">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#16121D" />
    <script is:inline>
      // Tema aleasa de utilizator, aplicata inainte de prima randare (fara palpait).
      // Fara alegere: urmeaza setarea sistemului (prefers-color-scheme).
      try {
        const t = localStorage.getItem("tema");
        if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
      } catch {}
    </script>
    <meta name="robots" content="noindex, nofollow" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Cataloage" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" crossorigin="use-credentials" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@500;600;700&family=Manrope:wght@400;500;600;700&display=swap" />
    <style is:global>
      /* Tema intunecata (implicita cand sistemul e intunecat sau utilizatorul a ales-o). */
      :root {
        --bg: #16121D;
        --bg-2: #1E1927;
        --bg-3: #262031;
        --text: #F4EFF8;
        --text-2: #C9C0D6;
        --muted: #A99FB8;
        --faint: #6E6580;
        --line: rgba(244, 239, 248, 0.10);
        --coral: #F4876A;  --coral-rgb: 244, 135, 106;
        --teal: #4EC5BE;   --teal-rgb: 78, 197, 190;
        --violet: #B393F2; --violet-rgb: 179, 147, 242;
        --verde: #6FE3A5;  --verde-rgb: 111, 227, 165;
        --galben: #F2C25B; --galben-rgb: 242, 194, 91;
        --live: #6FE3A5;
        --wip: #F2C25B;
        --pe-accent: #16121D;           /* textul pus pe un fundal de accent */
        --umbra: 0 1px 2px rgba(0, 0, 0, 0.3);
        --display: 'Outfit', 'Avenir Next', 'Segoe UI', sans-serif;
        --body: 'Manrope', 'Avenir Next', 'Segoe UI', sans-serif;
        --mono: ui-monospace, 'Cascadia Mono', 'Consolas', monospace;
        color-scheme: dark;
      }
      /* Tema alba: aceleasi variabile, alte valori. Accentele sunt mai inchise, ca sa aiba contrast. */
      @media (prefers-color-scheme: light) {
        :root:not([data-theme="dark"]) {
          --bg: #F7F5FA; --bg-2: #FFFFFF; --bg-3: #EFEBF4;
          --text: #1A1523; --text-2: #3F3750; --muted: #6B6280; --faint: #9A92AA;
          --line: rgba(26, 21, 35, 0.10);
          --coral: #D9634A;  --coral-rgb: 217, 99, 74;
          --teal: #1E9A93;   --teal-rgb: 30, 154, 147;
          --violet: #7A55D6; --violet-rgb: 122, 85, 214;
          --verde: #2E9E63;  --verde-rgb: 46, 158, 99;
          --galben: #B9861B; --galben-rgb: 185, 134, 27;
          --live: #2E9E63; --wip: #B9861B;
          --pe-accent: #FFFFFF;
          --umbra: 0 1px 2px rgba(26, 21, 35, 0.08);
          color-scheme: light;
        }
      }
      :root[data-theme="light"] {
        --bg: #F7F5FA; --bg-2: #FFFFFF; --bg-3: #EFEBF4;
        --text: #1A1523; --text-2: #3F3750; --muted: #6B6280; --faint: #9A92AA;
        --line: rgba(26, 21, 35, 0.10);
        --coral: #D9634A;  --coral-rgb: 217, 99, 74;
        --teal: #1E9A93;   --teal-rgb: 30, 154, 147;
        --violet: #7A55D6; --violet-rgb: 122, 85, 214;
        --verde: #2E9E63;  --verde-rgb: 46, 158, 99;
        --galben: #B9861B; --galben-rgb: 185, 134, 27;
        --live: #2E9E63; --wip: #B9861B;
        --pe-accent: #FFFFFF;
        --umbra: 0 1px 2px rgba(26, 21, 35, 0.08);
        color-scheme: light;
      }
      /* Accentul unui catalog: clasa culoare-* pe container. */
      .culoare-coral { --accent: var(--coral); --accent-rgb: var(--coral-rgb); }
      .culoare-teal { --accent: var(--teal); --accent-rgb: var(--teal-rgb); }
      .culoare-violet { --accent: var(--violet); --accent-rgb: var(--violet-rgb); }
      .culoare-verde { --accent: var(--verde); --accent-rgb: var(--verde-rgb); }
      .culoare-galben { --accent: var(--galben); --accent-rgb: var(--galben-rgb); }

      * { box-sizing: border-box; }
      [hidden] { display: none !important; }
      html, body { margin: 0; padding: 0; }
      body {
        background: var(--bg);
        color: var(--text);
        font-family: var(--body);
        font-size: 16px;
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
        min-height: 100dvh;
        display: flex;
        flex-direction: column;
      }
      a { color: inherit; text-decoration: none; }
      a:focus-visible, button:focus-visible, input:focus-visible, textarea:focus-visible, select:focus-visible {
        outline: 2px solid var(--coral); outline-offset: 2px; border-radius: 6px;
      }
      button, input, select, textarea { font: inherit; }
      h1, h2, h3 { font-family: var(--display); font-weight: 600; letter-spacing: -0.01em; line-height: 1.15; margin: 0; }
      h1 { font-size: 34px; }
      h2 { font-size: 22px; }
      h3 { font-size: 17px; }
      p { margin: 0; }

      .continut { flex: 1; min-width: 0; width: 100%; margin: 0 auto; padding: 28px 20px 56px; max-width: 780px; }
      .continut.lat { max-width: 1160px; }
      @media (min-width: 900px) { .continut { padding: 40px 40px 72px; } }

      .subsol {
        padding: 14px 20px; border-top: 1px solid var(--line);
        font-size: 12.5px; font-weight: 600; color: var(--faint);
        display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap;
      }

      /* Butoane */
      .buton {
        display: inline-flex; align-items: center; justify-content: center; gap: 8px;
        padding: 9px 16px; border-radius: 999px; border: 1px solid var(--line);
        background: transparent; color: var(--text-2); font-weight: 600; font-size: 14px; cursor: pointer;
        transition: border-color 0.15s, color 0.15s, background 0.15s;
      }
      .buton:hover { border-color: var(--violet); color: var(--violet); }
      .buton.principal { background: var(--accent, var(--violet)); border-color: transparent; color: var(--pe-accent); font-size: 15px; padding: 11px 20px; }
      .buton.principal:hover { filter: brightness(1.08); color: var(--pe-accent); }
      .buton.periculos:hover { border-color: var(--coral); color: var(--coral); }
      .buton[aria-disabled="true"], .buton:disabled { opacity: 0.45; cursor: not-allowed; pointer-events: none; }
      .buton.mic { padding: 5px 10px; font-size: 13px; }

      /* Insigne de stare */
      .insigna {
        display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px; border-radius: 999px;
        font-size: 12px; font-weight: 700; letter-spacing: 0.02em; text-transform: uppercase; white-space: nowrap;
      }
      .insigna::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
      .insigna.activ { color: var(--live); background: rgba(var(--verde-rgb), 0.14); }
      .insigna.in_lucru { color: var(--wip); background: rgba(var(--galben-rgb), 0.14); }
      .insigna.arhivat { color: var(--muted); background: var(--line); }

      /* Text randat din Markdown (note de utilizare, pagina de acces) */
      .proza { color: var(--text-2); font-size: 16px; }
      .proza h1, .proza h2, .proza h3 { color: var(--text); margin: 22px 0 8px; }
      .proza h1 { font-size: 24px; } .proza h2 { font-size: 20px; } .proza h3 { font-size: 17px; }
      .proza p { margin: 0 0 12px; }
      .proza ul, .proza ol { margin: 0 0 12px; padding-left: 22px; }
      .proza li { margin: 4px 0; }
      .proza a { color: var(--violet); text-decoration: underline; text-underline-offset: 3px; }
      .proza code { font-family: var(--mono); font-size: 0.92em; background: var(--bg-3); padding: 1px 6px; border-radius: 6px; }
      .proza pre { background: var(--bg-3); padding: 12px 14px; border-radius: 12px; overflow-x: auto; }
      .proza pre code { background: none; padding: 0; }
      .proza strong { color: var(--text); }
      .proza .sarcina { list-style: none; margin-left: -22px; display: flex; gap: 8px; }
      .proza .sarcina.gata span { color: var(--faint); text-decoration: line-through; }

      /* Mesaje de formular */
      .mesaj { padding: 10px 14px; border-radius: 12px; font-size: 14px; font-weight: 600; margin-bottom: 18px; }
      .mesaj.ok { background: rgba(var(--verde-rgb), 0.14); color: var(--live); }
      .mesaj.eroare { background: rgba(var(--coral-rgb), 0.14); color: var(--coral); }
    </style>
    <slot name="head" />
  </head>
  <body>
    <Bara />
    <main class:list={["continut", { lat }]}>
      <slot />
    </main>
    <footer class="subsol">
      <span>conectat ca {email}</span>
      <a href="https://dumitru.cloud">dumitru.cloud</a>
    </footer>
  </body>
</html>

---
// Un card din grila de pe prima pagina: plat, cu chenar fin; culoarea catalogului apare doar
// in pictograma mica si la hover.
import Pictograma from "./Pictograma.astro";
import type { CatalogRezumat } from "../lib/db";
import { ETICHETE_STARE } from "../lib/validare";
import { fmtMoment } from "../lib/data";

interface Props {
  catalog: CatalogRezumat;
}
const { catalog: c } = Astro.props;
const plural = (n: number, unu: string, multe: string) => `${n} ${n === 1 ? unu : multe}`;
---

<a class:list={["card", `culoare-${c.culoare}`]} href={`/c/${c.slug}`}>
  <div class="sus">
    <div class="icon"><Pictograma nume={c.pictograma} marime={18} /></div>
    <span class:list={["insigna", c.stare]}>{ETICHETE_STARE[c.stare]}</span>
  </div>
  <h2>{c.titlu}</h2>
  {c.descriere && <p class="descriere">{c.descriere}</p>}
  <div class="jos">
    <span>{plural(c.nr_surse, "sursă", "surse")}</span>
    {c.nr_audio > 0 && <span>· {plural(c.nr_audio, "audio", "audio")}</span>}
    <span class="data">{fmtMoment(c.actualizat_la)}</span>
  </div>
</a>

<style>
  .card {
    display: flex; flex-direction: column; gap: 10px; padding: 22px 24px 20px;
    border-radius: 18px; border: 1px solid var(--line); background: var(--bg-2);
    transition: border-color 0.18s ease, transform 0.18s ease;
  }
  .card:hover { border-color: rgba(var(--accent-rgb), 0.6); transform: translateY(-2px); }
  .sus { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 4px; }
  .icon {
    width: 32px; height: 32px; border-radius: 10px; display: grid; place-items: center;
    background: rgba(var(--accent-rgb), 0.16); color: var(--accent);
  }
  h2 { font-size: 22px; letter-spacing: -0.01em; }
  .card:hover h2 { color: var(--accent); }
  .descriere {
    color: var(--muted); font-size: 14.5px; line-height: 1.5;
    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
  }
  .jos {
    margin-top: auto; padding-top: 10px; display: flex; flex-wrap: wrap; gap: 6px; align-items: center;
    font-size: 13px; font-weight: 600; color: var(--faint);
  }
  .jos .data { margin-left: auto; font-weight: 500; }
  @media (prefers-reduced-motion: reduce) { .card { transition: none; } .card:hover { transform: none; } }
</style>

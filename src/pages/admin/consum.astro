---
// Admin: consumul per utilizator, limite, blocare, setari (limita implicita, model).
import { env } from "cloudflare:workers";
import Base from "../../layouts/Base.astro";
import { citesteSetare, costUltimele30Zile, fmtCost, limitaImplicita, raportUtilizatori } from "../../lib/consum";
import { aziChisinau, fmtZi } from "../../lib/data";
import { MODELE, TARIFE } from "../../lib/validare";

const azi = aziChisinau();
const [raport, limita, model, cost30] = await Promise.all([
  raportUtilizatori(env.DB, azi), limitaImplicita(env.DB), citesteSetare(env.DB, "model"), costUltimele30Zile(env.DB, azi),
]);
const eroare = Astro.url.searchParams.get("eroare");
const ok = Astro.url.searchParams.has("ok");
const totalAzi = raport.reduce((s, r) => s + r.azi, 0);
const total30 = raport.reduce((s, r) => s + r.zile30, 0);
const fmtTokeni = (n: number) => n >= 1_000_000 ? `${(n / 1_000_000).toFixed(1).replace(".", ",")} M` : n >= 1000 ? `${Math.round(n / 1000)} k` : String(n);
---

<Base title="Consum · Admin" lat>
  <p class="cale"><a href="/admin">Administrare</a> / Consum</p>
  <header class="antet">
    <h1>Consum și limite</h1>
    <div class="cifre">
      <span><strong>{totalAzi}</strong> întrebări azi</span>
      <span><strong>{total30}</strong> în 30 de zile</span>
      <span><strong>{fmtCost(cost30)}</strong> cost în 30 de zile</span>
    </div>
  </header>

  {eroare && <p class="mesaj eroare">{eroare}</p>}
  {ok && <p class="mesaj ok">Salvat.</p>}

  <form method="post" action="/admin/actiuni/setari" class="setari">
    <label>
      <span>Limita implicită pe zi</span>
      <input name="limita_zi_implicita" type="number" min="0" max="10000" value={limita} required />
    </label>
    <label>
      <span>Model</span>
      <select name="model">
        {MODELE.map((m) => <option value={m} selected={m === model}>{TARIFE[m]!.eticheta} · {TARIFE[m]!.intrare.toFixed(2)} / {TARIFE[m]!.iesire.toFixed(2)} $ per M tokeni</option>)}
      </select>
    </label>
    <button class="buton" type="submit">Salvează setările</button>
  </form>

  <h2>Utilizatori <span class="numar">{raport.length}</span></h2>
  {raport.length === 0 ? (
    <p class="gol">Nimeni nu a intrat încă.</p>
  ) : (
    <div class="tabel-invelis">
      <table>
        <thead>
          <tr>
            <th>E-mail</th><th class="nr">Azi</th><th class="nr">7 zile</th><th class="nr">30 zile</th><th class="nr">Total</th>
            <th class="nr">Tokeni</th><th class="nr">Cost 30 z.</th><th>Ultima vizită</th><th>Limită / zi</th><th>Blocat</th><th>Notă</th><th></th>
          </tr>
        </thead>
        <tbody>
          {raport.map((r) => (
            <tr class:list={{ blocat: r.blocat === 1 }}>
              <form method="post" action={`/admin/actiuni/utilizator/${encodeURIComponent(r.email)}`} id={`f-${r.email}`}></form>
              <td class="email">{r.email}</td>
              <td class="nr">{r.azi}</td>
              <td class="nr">{r.zile7}</td>
              <td class="nr">{r.zile30}</td>
              <td class="nr">{r.total}</td>
              <td class="nr" title={`${r.tokens_intrare} intrare · ${r.tokens_iesire} ieșire`}>{fmtTokeni(r.tokens_intrare + r.tokens_iesire)}</td>
              <td class="nr">{fmtCost(r.cost_30_microdolari)}</td>
              <td>{r.ultima_vizita ? fmtZi(r.ultima_vizita) : "—"}</td>
              <td><input form={`f-${r.email}`} name="limita_zi" type="number" min="0" max="10000" value={r.limita_zi ?? ""} placeholder={`implicit ${limita}`} aria-label="Limită pe zi" /></td>
              <td><label class="bifa"><input form={`f-${r.email}`} name="blocat" type="checkbox" value="1" checked={r.blocat === 1} /> blocat</label></td>
              <td><input form={`f-${r.email}`} name="nota" value={r.nota ?? ""} placeholder="notă" aria-label="Notă" /></td>
              <td><button form={`f-${r.email}`} class="buton mic" type="submit">Salvează</button></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}
  <p class="lamurire">
    Costul e estimat din tokenii raportați de Google și tarifele modelului. Limita goală înseamnă limita implicită.
    Un utilizator blocat nu mai poate deschide nicio pagină; adminul nu poate fi blocat.
  </p>
</Base>

<style>
  .cale { color: var(--faint); font-size: 13px; font-weight: 600; margin-bottom: 6px; }
  .cale a:hover { color: var(--text); }
  .antet { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-bottom: 20px; }
  .cifre { display: flex; gap: 18px; flex-wrap: wrap; color: var(--muted); font-size: 14px; font-weight: 600; }
  .cifre strong { color: var(--text); font-size: 18px; margin-right: 4px; }
  .setari { display: flex; gap: 12px; align-items: flex-end; flex-wrap: wrap; padding: 16px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); margin-bottom: 32px; }
  .setari label { display: flex; flex-direction: column; gap: 5px; font-size: 12px; font-weight: 700; color: var(--faint); text-transform: uppercase; letter-spacing: 0.05em; }
  .setari input, .setari select, td input {
    padding: 7px 10px; border-radius: 10px; border: 1px solid var(--line); background: var(--bg-2); color: var(--text); font-size: 14px; text-transform: none; letter-spacing: 0;
  }
  .setari input { width: 120px; }
  h2 { display: flex; align-items: baseline; gap: 10px; margin-bottom: 12px; }
  .numar { color: var(--faint); font-size: 15px; font-weight: 600; }
  .gol { color: var(--muted); }
  .tabel-invelis { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: 14px; }
  th, td { padding: 10px 8px; text-align: left; border-bottom: 1px solid var(--line); white-space: nowrap; }
  th { color: var(--faint); font-size: 11.5px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; }
  td:first-child, th:first-child { padding-left: 0; }
  td:last-child, th:last-child { padding-right: 0; }
  th.nr, td.nr { text-align: right; font-variant-numeric: tabular-nums; }
  tr.blocat td { opacity: 0.75; }
  tr.blocat td.email { color: var(--coral); }
  td.email { font-weight: 600; }
  td input[name=limita_zi] { width: 90px; }
  td input[name=nota] { width: 160px; }
  .bifa { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; color: var(--muted); }
  .lamurire { color: var(--faint); font-size: 13px; margin-top: 14px; }
</style>

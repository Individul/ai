---
// Bara de sus: brand si navigare. "Admin" apare doar pentru administrator.
// Langa "Consum" e costul propriu de la inceput; langa "Admin", costul tuturor.
import { env } from "cloudflare:workers";
import { costPropriu, costTotalToti, fmtCost } from "../lib/consum";

const cale = Astro.url.pathname;
const admin = Astro.locals.admin;
const [propriu, toti] = await Promise.all([
  costPropriu(env.DB, Astro.locals.email),
  admin ? costTotalToti(env.DB) : Promise.resolve(0),
]);
const activ = (prefix: string) => (prefix === "/" ? cale === "/" || cale.startsWith("/c/") : cale.startsWith(prefix));
---

<header class="bara">
  <a class="brand" href="/">Cataloage<span>.</span></a>
  <nav aria-label="Navigare principală">
    <a href="/" class:list={{ activ: activ("/") }}>Cataloage</a>
    <a href="/consum" class:list={{ activ: activ("/consum") }}>Consum <span class="suma" title="costul tău de la început">{fmtCost(propriu)}</span></a>
    <a href="/acces" class:list={{ activ: activ("/acces") }}>Cum obțin acces</a>
    {admin && <a href="/admin" class:list={["admin", { activ: activ("/admin") }]}>Admin <span class="suma" title="costul tuturor de la început">{fmtCost(toti)}</span></a>}
  </nav>
  <button type="button" class="tema" data-tema title="Temă albă / întunecată" aria-label="Schimbă tema">
    <svg class="soare" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
    <svg class="luna" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z"/></svg>
  </button>
</header>

<script>
  // Comutatorul de tema: alterneaza fata de tema afisata acum si memoreaza alegerea.
  const b = document.querySelector<HTMLButtonElement>("[data-tema]");
  const meta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
  const curenta = () =>
    document.documentElement.dataset.theme ?? (matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark");
  const aplica = () => { if (meta) meta.content = curenta() === "light" ? "#F7F5FA" : "#16121D"; };
  b?.addEventListener("click", () => {
    const noua = curenta() === "light" ? "dark" : "light";
    document.documentElement.dataset.theme = noua;
    try { localStorage.setItem("tema", noua); } catch { /* fara stocare */ }
    aplica();
  });
  aplica();
</script>

<style>
  .bara {
    display: flex; align-items: center; gap: 16px;
    height: 60px; padding: 0 20px; border-bottom: 1px solid var(--line);
  }
  .brand { font-family: var(--display); font-weight: 600; font-size: 20px; letter-spacing: -0.01em; }
  .brand span { color: var(--violet); }
  nav { display: flex; align-items: center; gap: 4px; margin-left: auto; }
  nav a {
    display: inline-flex; align-items: center; height: 36px; padding: 0 12px; border-radius: 10px;
    font-weight: 600; font-size: 14px; color: var(--muted); white-space: nowrap;
  }
  nav a:hover { color: var(--text); background: var(--line); }
  nav a.activ { color: var(--violet); }
  nav a.admin { color: var(--coral); }
  .suma { margin-left: 6px; font-size: 12px; font-weight: 700; color: var(--faint); font-variant-numeric: tabular-nums; }
  nav a.activ .suma, nav a:hover .suma { color: inherit; opacity: 0.75; }
  nav a.admin.activ { background: rgba(var(--coral-rgb), 0.12); }
  .tema {
    flex: none; width: 36px; height: 36px; border-radius: 10px; border: 0; background: transparent; color: var(--muted);
    display: grid; place-items: center; cursor: pointer; margin-left: 4px;
  }
  .tema:hover { color: var(--text); background: var(--line); }
  .tema .soare { display: none; }
  :root[data-theme="dark"] .tema .soare { display: block; }
  :root[data-theme="dark"] .tema .luna { display: none; }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .tema .soare { display: block; }
    :root:not([data-theme="light"]) .tema .luna { display: none; }
  }
  @media (max-width: 640px) {
    .bara { gap: 10px; padding: 0 14px; }
    nav { overflow-x: auto; scrollbar-width: none; -webkit-overflow-scrolling: touch; margin-right: -14px; padding-right: 14px; }
    nav::-webkit-scrollbar { display: none; }
    nav a { padding: 0 9px; font-size: 13px; }
    .suma { display: none; }
  }
</style>
